# Copy to .env.local (never commit real values). Server-only: these are not exposed to the browser.

# Application mode: DEMO keeps virtual balances in Prisma; ALPHA routes the financial path through Soroban.
APP_MODE="DEMO"

# Provider mode: simulation | sandbox | production (documentation flag; each client defaults to sandbox)
INTEGRATION_MODE="simulation"

# Sumsub KYC/KYB (sandbox by default; production only after a signed provider agreement)
SUMSUB_ENVIRONMENT="test"
SUMSUB_APP_TOKEN=""
SUMSUB_SECRET_KEY=""
SUMSUB_WEBHOOK_SECRET=""
SUMSUB_LEVEL_NAME="vartola-demo"
SUMSUB_PROD_APP_TOKEN=""
SUMSUB_PROD_SECRET_KEY=""
SUMSUB_PROD_WEBHOOK_SECRET=""
SUMSUB_PROD_LEVEL_NAME=""

# Transak fiat on/off-ramp (sandbox)
TRANSAK_API_KEY=""
TRANSAK_API_SECRET=""
TRANSAK_WEBHOOK_SECRET=""
TRANSAK_ENVIRONMENT="staging"

# Circle treasury and Stellar USDC (sandbox by default)
CIRCLE_API_KEY=""
CIRCLE_WEBHOOK_PUBLIC_KEY=""
CIRCLE_ENVIRONMENT="sandbox"
CIRCLE_PROD_API_KEY=""

# Private document storage (S3-compatible). Required for Alpha document storage.
S3_BUCKET=""
S3_REGION="me-central-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Operations: scheduled reconciliation, alerts and notification providers
CRON_SECRET=""
ALERT_EMAIL=""
EMAIL_PROVIDER_URL=""
SMS_PROVIDER_URL=""

# Server-held secrets (never commit; managed secret store in production)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:4200"
WALLET_KEK=""
SERVER_MASTER_KEY=""
CONFIG_ENCRYPTION_KEY=""

# Stellar Testnet — never place production secret keys in a committed file
STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
